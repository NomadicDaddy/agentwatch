{
	"name": "agentwatch",
	"version": "0.1.0",
	"packageManager": "bun@1.3.14",
	"author": "NomadicDaddy",
	"description": "Cross-platform TypeScript/Bun CLI for local, read-only inspection of AI-agent capability surfaces",
	"dependencies": {
		"commander": "^14.0.3",
		"fast-glob": "^3.3.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.3.14",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"@typescript-eslint/parser": "^8.63.0",
		"eslint": "^10.6.0",
		"eslint-plugin-perfectionist": "5.10.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.7.0",
		"only-allow": "^1.2.2",
		"prettier": "3.9.5",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-sort-json": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.63.0"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24.0.0 <25.0.0"
	},
	"scripts": {
		"build": "bun build ./src/cli.ts --target=bun --outdir=dist",
		"compile": "bun build ./src/cli.ts --compile --outfile=dist/agentwatch",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint --fix \"src/**/*.ts\"",
		"scan:fixtures": "bun ./scripts/scan-fixtures.ts",
		"smoke:qc": "bun run typecheck && bun run lint && bun run format:check",
		"start": "bun src/cli.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"preinstall": "only-allow bun"
	},
	"type": "module",
	"bin": {
		"agentwatch": "./src/cli.ts"
	},
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"src",
		"scripts",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"agent",
		"security",
		"mcp",
		"ai",
		"audit",
		"cli"
	],
	"license": "MIT"
}
